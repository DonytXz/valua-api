# =============================================================================
# Valua API Environment Configuration
# =============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,https://donatoalvarez.dev,https://donytxz.github.io

# Storage Backend Driver ('file' | 'firebase' | 'postgres')
STORAGE_DRIVER=file

# -----------------------------------------------------------------------------
# Optional: Firebase Admin SDK Configuration (if using Firebase server-side)
# -----------------------------------------------------------------------------
# Path to service account private key JSON file (keep secure, never commit)
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://property-valuator.firebaseio.com
FIREBASE_PROJECT_ID=property-valuator

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=50
